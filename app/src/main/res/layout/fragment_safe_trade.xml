<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tituloSafe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sinais de Compra Seguros"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnAtualizarSinais"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Atualizar Sinais Manualmente"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnStartAutoUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar Atualização Automática"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnBacktest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Executar Backtest"
        android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSafeSignals"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtBacktestResumo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resultado do Backtest aparecerá aqui"
        android:textSize="14sp"
        android:textColor="#333"
        android:paddingTop="12dp"
        android:visibility="gone" />
</LinearLayout>
