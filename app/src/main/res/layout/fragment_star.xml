<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Barra de progresso para quando estiver carregando -->
        <ProgressBar
            android:id="@+id/progressLoading"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- RecyclerView para exibir os tickers pontuados -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvMsgErro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:visibility="gone"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_gravity="top">

            <TextView
                android:id="@+id/tvResumoEstrategia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:background="#FFF8DC"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginTop="16dp"/>

            <Button
                android:id="@+id/btnGerarPerguntaHedge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔮 Gerar Análise Nível 99% Hedge"
                android:layout_marginTop="16dp"/>

            <Button
                android:id="@+id/btnGerarPerguntaEstrategia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 Gerar pergunta para IA com base na estratégia"
                android:layout_marginTop="12dp"/>

            <Button
                android:id="@+id/btnAbrirChatGPT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💬 Usar Pergunta no ChatGPT"
                android:layout_marginTop="12dp"/>


            <Button
                android:id="@+id/btnPerguntaMutual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔎 Gerar Pergunta Nível 99% para IA Mutual"
                android:layout_marginTop="16dp"/>

        </LinearLayout>


    </FrameLayout>



</LinearLayout>
